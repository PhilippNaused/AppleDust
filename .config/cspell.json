{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
  "version": "0.2",
  "language": "en-US",
  "useGitignore": true,
  "words": [],
  "flagWords": [],
  "ignorePaths": [
    ".config/cspell.json",
    ".config/dicts/**",
    ".config/dotnet-tools.json",
    ".git*",
    "*.DotSettings",
    "*.svg",
    "tests/**/Snapshots/**"
  ],
  "dictionaries": [
    "project-words"
  ],
  "dictionaryDefinitions": [
    {
      "name": "project-words",
      "path": "./dicts/project-words.txt",
      "addWords": true
    }
  ]
}